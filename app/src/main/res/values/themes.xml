<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#FF07090E</color>

    <style name="Theme.Spectatilus" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorAccent">#FF8B6CFF</item>
    </style>

    <style name="Theme.Spectatilus.Player" parent="Theme.Spectatilus">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
