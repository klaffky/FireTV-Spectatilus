---
import Base from '../layouts/Base.astro';
import CtaButton from '../components/CtaButton.astro';
import { path, useT } from '../i18n/ui.ts';

const lang = Astro.url.pathname.includes('/en/') || Astro.url.pathname.endsWith('/en') ? 'en' : 'de';
const t = useT(lang);
---

<Base lang={lang} route="home" title={`${t('notfound.title')} – Spreeblick`} description={t('notfound.text')} noindex>
  <div class="container-x py-24 md:py-32">
    <p class="font-display text-[clamp(5rem,18vw,11rem)] italic leading-none text-amber/60" aria-hidden="true">404</p>
    <h1 class="mt-4 text-[clamp(2.2rem,5vw,3.5rem)] font-medium text-spree">{t('notfound.title')}</h1>
    <p class="mt-4 max-w-xl text-lg text-ink-soft">{t('notfound.text')}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={path('home', lang)} class="btn-ghost text-spree">{t('nav.home')}</a>
      <a href={path('menu', lang)} class="btn-ghost text-spree">{t('nav.menu')}</a>
      <CtaButton href={path('reserve', lang)}>{t('nav.reserve')}</CtaButton>
    </div>
  </div>
</Base>
