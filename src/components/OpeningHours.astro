---
import { openingHours } from '../config/site.ts';
import { days, useT, type Lang } from '../i18n/ui.ts';

interface Props {
  lang: Lang;
  tone?: 'dark' | 'light';
}
const { lang, tone = 'dark' } = Astro.props;
const t = useT(lang);
const names = days(lang);
---

<ul class="opening-hours divide-y" class:list={[tone === 'dark' ? 'divide-paper/15' : 'divide-line']} data-hours>
  {
    openingHours.map(({ day, opensFrom }) => (
      <li class="relative flex items-baseline justify-between gap-4 py-2.5" data-day={day}>
        <span class="flex items-center gap-2.5">
          <span class="capitalize">{names[day]}</span>
          <span class="today-badge hidden rounded-full bg-amber px-2 py-px text-[0.7rem] font-bold uppercase tracking-wider text-ink">
            {t('hours.today')}
          </span>
        </span>
        {opensFrom ? (
          <span class="tabular-nums">{t('hours.from')}</span>
        ) : (
          <span class:list={['font-semibold italic', tone === 'dark' ? 'text-amber-soft' : 'text-brick']}>{t('hours.closed')}</span>
        )}
      </li>
    ))
  }
</ul>

<script>
  // „Heute“ nach Berliner Zeit markieren
  const weekday = new Intl.DateTimeFormat('en-US', { timeZone: 'Europe/Berlin', weekday: 'short' }).format(new Date());
  const index = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(weekday);
  document.querySelectorAll(`[data-hours] [data-day="${index}"]`).forEach((li) => {
    li.classList.add('is-today', 'font-semibold');
    li.querySelector('.today-badge')?.classList.remove('hidden');
  });
</script>
