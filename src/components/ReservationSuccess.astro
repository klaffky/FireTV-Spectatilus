---
import Icon from './Icon.astro';
import { path, useT, type Lang } from '../i18n/ui.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<!-- Wird nach dem Absenden vom Skript befüllt und eingeblendet -->
<section
  data-success
  hidden
  tabindex="-1"
  aria-labelledby="success-title"
  class="relative scroll-mt-28 overflow-hidden rounded-[1.75rem] border border-line bg-card p-7 focus:outline-none sm:p-10"
>
  <div class="flex size-14 items-center justify-center rounded-full bg-spree text-paper" aria-hidden="true">
    <Icon name="check" class="size-7" />
  </div>
  <h2 id="success-title" class="mt-6 text-[clamp(1.8rem,4vw,2.5rem)] font-medium text-spree" data-out="title">
    {t('res.done.title')}
  </h2>
  <p class="mt-3 text-lg text-ink-soft">{t('res.done.text')}</p>

  <dl class="mt-8 grid gap-x-8 gap-y-4 rounded-2xl bg-paper p-5 sm:grid-cols-2 sm:p-6">
    <div>
      <dt class="text-sm text-ink-soft">{t('res.summary.date')}</dt>
      <dd class="font-display text-xl" data-out="date"></dd>
    </div>
    <div>
      <dt class="text-sm text-ink-soft">{t('res.summary.time')}</dt>
      <dd class="font-display text-xl tabular-nums" data-out="time"></dd>
    </div>
    <div>
      <dt class="text-sm text-ink-soft">{t('res.summary.guests')}</dt>
      <dd class="font-display text-xl" data-out="guests"></dd>
    </div>
    <div>
      <dt class="text-sm text-ink-soft">{t('res.done.ref')}</dt>
      <dd class="font-mono text-lg tracking-wider" data-out="ref"></dd>
    </div>
  </dl>

  <p class="mt-6 rounded-2xl bg-amber-soft/35 p-4 text-ink ring-1 ring-amber/40" data-out="mailto" hidden>
    {t('res.done.mailto')}
  </p>
  <p class="mt-4 text-sm text-ink-soft">{t('terrace')}</p>

  <div class="mt-8 flex flex-wrap gap-3">
    <a href={path('reserve', lang)} class="btn-ghost text-spree">{t('res.done.again')}</a>
    <a href={path('home', lang)} class="btn-ghost text-spree">{t('res.done.home')}</a>
  </div>
</section>
