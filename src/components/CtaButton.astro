---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & { current?: boolean };
const { class: className, current, ...rest } = Astro.props;
---

<a class:list={['btn-cta', className]} aria-current={current ? 'page' : undefined} {...rest}>
  <span><slot /></span>
  <svg class="cta-arrow size-4 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M2.5 8h10M9 4l4 4-4 4"></path>
  </svg>
</a>
