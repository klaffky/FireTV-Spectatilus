---
import Icon from './Icon.astro';
import { useT, type Lang } from '../i18n/ui.ts';

interface Props {
  lang: Lang;
  tone?: 'dark' | 'light';
  class?: string;
  /** Wortlaut der Kontaktseite („… an.“) statt Startseite („… entgegen.“) */
  variant?: 'home' | 'contact';
}
const { lang, tone = 'light', class: className, variant = 'home' } = Astro.props;
const t = useT(lang);
---

<p
  class:list={[
    'flex items-start gap-3 rounded-2xl px-4 py-3 text-[0.95rem] leading-snug',
    tone === 'dark' ? 'bg-paper/10 text-paper/90 ring-1 ring-paper/15' : 'bg-amber-soft/35 text-ink ring-1 ring-amber/40',
    className,
  ]}
>
  <Icon name="info" class:list={['mt-0.5 size-5 shrink-0', tone === 'dark' ? 'text-amber-soft' : 'text-brick']} />
  <span><strong class="font-semibold">{t('notice')}:</strong> {t(variant === 'contact' ? 'terrace.contact' : 'terrace')}</span>
</p>
