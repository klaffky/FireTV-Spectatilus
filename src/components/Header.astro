---
import Logo from './Logo.astro';
import CtaButton from './CtaButton.astro';
import Icon from './Icon.astro';
import { site } from '../config/site.ts';
import { path, useT, type Lang, type RouteKey } from '../i18n/ui.ts';

interface Props {
  lang: Lang;
  route: RouteKey;
  overlay?: boolean;
}
const { lang, route, overlay = false } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'de' ? 'en' : 'de';
const switchHref = path(route, other);

const links = [
  { key: 'home', label: t('nav.home') },
  { key: 'menu', label: t('nav.menu') },
  { key: 'contact', label: t('nav.contact') },
] as const;
const isCurrent = (key: RouteKey) => key === route;
---

<header
  class:list={[
    'site-header inset-x-0 top-0 z-50 transition-[background-color,color,box-shadow] duration-300',
    overlay ? 'fixed text-paper' : 'sticky',
  ]}
  data-scrolled={overlay ? 'false' : 'true'}
  data-overlay={overlay ? 'true' : undefined}
>
  <div class="container-x flex h-[4.5rem] items-center gap-4 md:h-20">
    <a href={path('home', lang)} class="mr-auto block w-[9.5rem] shrink-0 sm:w-44" aria-label={`${site.name} – ${t('nav.home')}`}>
      <Logo />
    </a>

    <nav aria-label={t('nav.main')} class="hidden md:block">
      <ul class="flex items-center gap-7 text-[0.98rem] font-medium">
        {
          links.map((l) => (
            <li>
              <a href={path(l.key, lang)} class="link-flow" aria-current={isCurrent(l.key) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={switchHref}
            hreflang={other}
            lang={other}
            class="inline-flex h-9 min-w-9 items-center justify-center rounded-full border border-current/30 px-2.5 text-sm font-semibold tracking-wide hover:border-current"
            title={t('lang.switch')}
          >
            <span class="sr-only">{t('lang.switch')}</span>
            <span aria-hidden="true">{t('lang.label')}</span>
          </a>
        </li>
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={site.phone.href}
        class="inline-flex size-11 items-center justify-center rounded-full border border-current/30 md:hidden"
        aria-label={`${t('nav.call')}: ${site.phone.display}`}
      >
        <Icon name="phone" class="size-5" />
      </a>
      <CtaButton href={path('reserve', lang)} class="hidden !min-h-11 !px-5 sm:inline-flex" current={route === 'reserve'}>
        {t('nav.reserve')}
      </CtaButton>
      <button
        type="button"
        class="nav-toggle inline-flex size-11 items-center justify-center rounded-full border border-current/30 md:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-label-open={t('nav.open')}
        data-label-close={t('nav.close')}
        aria-label={t('nav.open')}
      >
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path class="origin-center transition-transform duration-300" d="M4 7h16" />
          <path class="transition-opacity duration-200" d="M4 12h16" />
          <path class="origin-center transition-transform duration-300" d="M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="border-t border-line bg-paper text-ink shadow-lg md:hidden" hidden>
    <nav aria-label={t('nav.main')} class="container-x py-6">
      <ul class="space-y-1 font-display text-3xl">
        {
          links.map((l) => (
            <li>
              <a
                href={path(l.key, lang)}
                class="flex items-center justify-between py-2.5"
                aria-current={isCurrent(l.key) ? 'page' : undefined}
              >
                {l.label}
                {isCurrent(l.key) && <span class="size-2 rounded-full bg-brick" aria-hidden="true" />}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-6 grid gap-3">
        <CtaButton href={path('reserve', lang)} class="w-full">{t('nav.reserve')}</CtaButton>
        <div class="flex items-center justify-between gap-4 pt-2 text-sm">
          <a href={site.phone.href} class="inline-flex items-center gap-2 font-semibold">
            <Icon name="phone" class="size-4" />
            {site.phone.display}
          </a>
          <a href={switchHref} hreflang={other} lang={other} class="font-semibold underline underline-offset-4">
            {t('lang.switch')}
          </a>
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  .nav-toggle path {
    transform-box: fill-box;
  }
  .nav-toggle[aria-expanded='true'] path:nth-child(1) {
    transform: translateY(5px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] path:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle[aria-expanded='true'] path:nth-child(3) {
    transform: translateY(-5px) rotate(-45deg);
  }
  /* Offenes Mobilmenü: Header immer hell */
  .site-header:has(.nav-toggle[aria-expanded='true']) {
    background: var(--color-paper);
    color: var(--color-ink);
  }
</style>
