---
import Base from '../layouts/Base.astro';
import CtaButton from '../components/CtaButton.astro';
import { getMenu, euro, type MenuCategory } from '../lib/menu.ts';
import { path, useT, type Lang } from '../i18n/ui.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const menu = getMenu(lang);
const groups: { id: 'speisen' | 'getraenke'; title: string; cats: MenuCategory[] }[] = [
  { id: 'speisen', title: t('menu.food'), cats: menu.filter((c) => c.section === 'speisen') },
  { id: 'getraenke', title: t('menu.drinks'), cats: menu.filter((c) => c.section === 'getraenke') },
];
const num = (i: number) => String(i + 1).padStart(2, '0');
---

<Base lang={lang} route="menu" title={t('seo.menu.title')} description={t('seo.menu.desc')}>
  <header class="container-x pb-8 pt-12 md:pb-10 md:pt-20">
    <p class="kicker" data-intro>Café & Restaurant Spreeblick</p>
    <h1 class="mt-4 text-[clamp(3rem,9vw,6.5rem)] font-medium text-spree" data-intro style="--i:1">{t('menu.title')}</h1>
    <div class="mt-6 flex flex-wrap gap-3" data-intro style="--i:2">
      {
        groups.map((g) => (
          <a href={`#${g.id}`} class="btn-ghost !min-h-11 text-spree">
            {g.title}
          </a>
        ))
      }
    </div>
  </header>

  <!-- Kategorie-Navigation: bleibt beim Scrollen sichtbar und markiert die aktuelle Kategorie -->
  <nav
    class="menu-nav sticky top-[4.5rem] z-30 border-y border-line bg-paper/95 backdrop-blur md:top-20"
    aria-label={t('menu.jump')}
  >
    <ul class="container-x flex gap-2 overflow-x-auto py-3 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {
        menu.map((c) => (
          <li class="shrink-0">
            <a
              href={`#${c.id}`}
              data-spy={c.id}
              class="block whitespace-nowrap rounded-full px-3.5 py-1.5 text-sm font-medium text-ink-soft transition-colors hover:bg-paper-deep hover:text-ink aria-[current=location]:bg-spree aria-[current=location]:text-paper"
            >
              {c.title}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {
    groups.map((g) => (
      <section
        id={g.id}
        aria-labelledby={`${g.id}-title`}
        class:list={['scroll-mt-36', g.id === 'getraenke' ? 'grain bg-spree-deep text-paper' : '']}
      >
        <div class="container-x py-16 md:py-24">
          <h2 id={`${g.id}-title`} class="font-display text-[clamp(2.4rem,6vw,4.5rem)] font-medium italic" data-reveal>
            {g.title}
          </h2>

          <div class="mt-10 space-y-16 md:space-y-20">
            {g.cats.map((cat) => (
              <section id={cat.id} aria-labelledby={`${cat.id}-h`} class="scroll-mt-36" data-spy-target={cat.id}>
                <div
                  class:list={[
                    'flex items-baseline gap-4 border-b pb-4',
                    g.id === 'getraenke' ? 'border-paper/20' : 'border-ink/15',
                  ]}
                  data-reveal
                >
                  <span
                    class:list={[
                      'font-display text-sm tabular-nums',
                      g.id === 'getraenke' ? 'text-amber-soft' : 'text-brick',
                    ]}
                    aria-hidden="true"
                  >
                    {num(menu.indexOf(cat))}
                  </span>
                  <h3 id={`${cat.id}-h`} class="font-display text-[clamp(1.7rem,3.6vw,2.4rem)] font-medium">
                    {cat.title}
                  </h3>
                </div>

                <ul class="grid gap-x-16 md:grid-cols-2">
                  {cat.entries.map((e, i) => (
                    <li
                      class:list={[
                        'flex items-baseline gap-3 border-b py-4',
                        g.id === 'getraenke' ? 'border-paper/10' : 'border-line/70',
                      ]}
                      data-reveal="item"
                      style={`--i:${i % 10}`}
                    >
                      <div class="min-w-0 flex-1">
                        <p class="font-semibold leading-snug md:text-[1.06rem]">{e.name}</p>
                        {e.description && (
                          <p
                            class:list={[
                              'mt-0.5 text-[0.95rem] leading-snug',
                              g.id === 'getraenke' ? 'text-paper/65' : 'text-ink-soft',
                            ]}
                          >
                            {e.description}
                          </p>
                        )}
                      </div>
                      {e.prices.length === 1 && !e.prices[0].size ? (
                        <span class="shrink-0 tabular-nums">{euro(e.prices[0].price, lang)}</span>
                      ) : (
                        <dl class="grid shrink-0 grid-cols-[auto_auto] items-baseline gap-x-3 text-right tabular-nums">
                          {e.prices.map((p) => (
                            <>
                              <dt class:list={['text-sm', g.id === 'getraenke' ? 'text-paper/60' : 'text-ink-soft']}>
                                {p.size}
                              </dt>
                              <dd>{euro(p.price, lang)}</dd>
                            </>
                          ))}
                        </dl>
                      )}
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="container-x py-16 text-center md:py-20">
    <h2 class="text-[clamp(1.9rem,4vw,2.8rem)] font-medium text-spree" data-reveal>{t('cta.title')}</h2>
    <div class="mt-7" data-reveal style="--i:1">
      <CtaButton href={path('reserve', lang)} class="!min-h-14 !px-8 text-lg">{t('nav.reserve')}</CtaButton>
    </div>
  </section>
</Base>

<script>
  // Scrollspy für die Kategorie-Navigation
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')].map((a) => [a.dataset.spy!, a]),
  );
  const visible = new Set<string>();
  let current = '';

  const setCurrent = (id: string) => {
    if (id === current) return;
    links.get(current)?.removeAttribute('aria-current');
    current = id;
    const link = links.get(id);
    if (!link) return;
    link.setAttribute('aria-current', 'location');
    // Aktive Kategorie in der horizontalen Leiste sichtbar halten (ohne die Seite zu scrollen)
    const bar = link.closest('ul')!;
    const left = link.offsetLeft - bar.clientWidth / 2 + link.clientWidth / 2;
    const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    bar.scrollTo({ left, behavior: smooth ? 'smooth' : 'auto' });
  };

  const order = [...links.keys()];
  const firstTop = document.getElementById(order[0])?.offsetTop ?? 0;
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        const id = (e.target as HTMLElement).dataset.spyTarget!;
        e.isIntersecting ? visible.add(id) : visible.delete(id);
      }
      const first = order.find((id) => visible.has(id));
      if (first) setCurrent(first);
      else if (window.scrollY < firstTop) setCurrent('');
    },
    { rootMargin: '-35% 0px -55% 0px' },
  );
  document.querySelectorAll<HTMLElement>('[data-spy-target]').forEach((s) => io.observe(s));
</script>
