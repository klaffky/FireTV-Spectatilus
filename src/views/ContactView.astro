---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CtaButton from '../components/CtaButton.astro';
import TerraceNotice from '../components/TerraceNotice.astro';
import { site } from '../config/site.ts';
import { path, useT, type Lang } from '../i18n/ui.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const formKey = import.meta.env.PUBLIC_WEB3FORMS_KEY as string | undefined;
const noJsAction = formKey ? 'https://api.web3forms.com/submit' : `mailto:${site.email}?subject=Kontaktanfrage`;
const messages = {
  required: t('err.required'),
  emailInvalid: t('err.emailInvalid'),
  tooLong: t('err.tooLong'),
  privacy: t('err.privacy'),
  'label.name': t('form.name'),
  'label.email': t('form.email'),
  'label.message': t('form.message'),
  'label.privacy': t('form.privacy2'),
};
---

<Base lang={lang} route="contact" title={t('seo.contact.title')} description={t('seo.contact.desc')}>
  <div class="container-x grid gap-14 pb-20 pt-12 md:pt-20 lg:grid-cols-12 lg:gap-16">
    <header class="lg:col-span-12">
      <p class="kicker" data-intro>Café & Restaurant Spreeblick</p>
      <h1 class="mt-4 text-[clamp(2.8rem,8vw,5.5rem)] font-medium text-spree" data-intro style="--i:1">{t('contactPage.title')}</h1>
    </header>

    <section class="lg:col-span-5" aria-labelledby="reservations-title">
      <div class="grain overflow-hidden rounded-[1.75rem] bg-spree-deep p-7 text-paper sm:p-9" data-reveal="left">
        <h2 id="reservations-title" class="font-display text-3xl font-medium">{t('contactPage.reservations')}</h2>
        <a href={site.phone.href} class="mt-5 flex items-center gap-3 font-display text-3xl hover:text-amber-soft sm:text-4xl">
          <Icon name="phone" class="size-7 text-amber-soft" />
          {site.phone.displayGrouped}
        </a>
        <a href={`mailto:${site.email}`} class="mt-3 flex items-center gap-3 text-lg hover:text-amber-soft">
          <Icon name="mail" class="size-6 text-amber-soft" />
          <span class="break-all">{site.email}</span>
        </a>
        <TerraceNotice lang={lang} tone="dark" variant="contact" class="mt-7" />
        <div class="mt-8 border-t border-paper/15 pt-7">
          <p class="text-paper/80">{t('contactPage.online')}</p>
          <CtaButton href={path('reserve', lang)} class="mt-4">{t('nav.reserve')}</CtaButton>
        </div>
      </div>
    </section>

    <section class="lg:col-span-7" aria-labelledby="write-title">
      <h2 id="write-title" class="font-display text-3xl font-medium text-spree" data-reveal>{t('contactPage.write')}</h2>

      <form method="post" action={noJsAction} enctype={formKey ? undefined : 'text/plain'} novalidate class="mt-7 space-y-6" data-contact-form>
        <script type="application/json" data-messages set:html={JSON.stringify(messages)} />
        <div data-summary hidden tabindex="-1" role="alert" class="rounded-2xl border-2 border-brick bg-card p-5 focus:outline-none">
          <p class="flex items-center gap-2 font-semibold text-brick-deep"><Icon name="alert" class="size-5" />{t('form.summary')}</p>
          <ul class="mt-2 list-disc space-y-1 pl-6 text-[0.95rem] [&_a]:underline"></ul>
        </div>
        <p data-status="ok" hidden tabindex="-1" role="status" class="flex items-center gap-3 rounded-2xl bg-spree p-5 font-semibold text-paper focus:outline-none">
          <Icon name="check" class="size-6 text-amber-soft" />{t('form.sent')}
        </p>
        <p data-status="mailto" hidden tabindex="-1" role="status" class="rounded-2xl bg-amber-soft/35 p-5 font-semibold text-ink ring-1 ring-amber/40 focus:outline-none">
          {t('form.mailto')}
        </p>
        <p data-status="error" hidden tabindex="-1" role="alert" class="rounded-2xl border-2 border-brick bg-card p-5 font-semibold text-brick-deep focus:outline-none">
          {t('form.failed')}
        </p>

        <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
          <label>Firma <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
        </div>
        <input type="hidden" name="started" value="" />
        {formKey && <input type="hidden" name="access_key" value={formKey} />}
        {formKey && <input type="hidden" name="subject" value="Kontaktanfrage über die Website" />}
        {formKey && <input type="hidden" name="redirect" value={new URL(path('contactThanks', lang), Astro.site).href} />}

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="c-name" class="field-label">{t('form.name')} <span class="text-brick" aria-hidden="true">*</span></label>
            <input id="c-name" name="name" type="text" required autocomplete="name" maxlength="120" class="field" aria-describedby="c-name-error" />
            <p id="c-name-error" class="field-error" data-error-for="name" aria-live="polite"></p>
          </div>
          <div>
            <label for="c-email" class="field-label">{t('form.email')} <span class="text-brick" aria-hidden="true">*</span></label>
            <input id="c-email" name="email" type="email" required autocomplete="email" maxlength="200" class="field" aria-describedby="c-email-error" />
            <p id="c-email-error" class="field-error" data-error-for="email" aria-live="polite"></p>
          </div>
        </div>
        <div>
          <label for="c-message" class="field-label">{t('form.message')} <span class="text-brick" aria-hidden="true">*</span></label>
          <textarea id="c-message" name="message" rows="8" required maxlength="5000" class="field" aria-describedby="c-message-error"></textarea>
          <p id="c-message-error" class="field-error" data-error-for="message" aria-live="polite"></p>
        </div>
        <div>
          <label class="flex items-start gap-3">
            <input type="checkbox" name="privacy" required class="check" aria-describedby="c-privacy-error" />
            <span>{t('form.privacy1')}<a href={path('privacy', lang)} class="font-semibold underline underline-offset-2">{t('form.privacy2')}</a>{t('form.privacy3')}</span>
          </label>
          <p id="c-privacy-error" class="field-error" data-error-for="privacy" aria-live="polite"></p>
        </div>
        <button type="submit" class="btn-cta !min-h-14 !px-8" data-busy-label={t('form.sending')}>
          <span data-label>{t('form.send')}</span>
          <svg class="cta-arrow size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 8h10M9 4l4 4-4 4"></path></svg>
        </button>
      </form>
    </section>
  </div>
</Base>

<script>
  import '../scripts/contact-form.ts';
</script>
