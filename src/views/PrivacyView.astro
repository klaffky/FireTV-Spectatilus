---
import Base from '../layouts/Base.astro';
import PrivacyDe from '../components/legal/PrivacyDe.astro';
import PrivacyEn from '../components/legal/PrivacyEn.astro';
import { useT, type Lang } from '../i18n/ui.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<Base lang={lang} route="privacy" title={t('seo.privacy.title')} description={t('seo.privacy.desc')}>
  <div class="container-x pb-20 pt-12 md:pt-20">
    <h1 class="text-[clamp(2.4rem,7vw,4.5rem)] font-medium text-spree" data-intro>{t('privacy.title')}</h1>
    <div class="prose-legal mt-8">
      {lang === 'de' ? <PrivacyDe /> : <PrivacyEn />}
    </div>
  </div>
</Base>
