---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CtaButton from '../components/CtaButton.astro';
import Icon from '../components/Icon.astro';
import Nikolaikirche from '../components/Nikolaikirche.astro';
import TerraceNotice from '../components/TerraceNotice.astro';
import gericht from '../assets/img/gericht.jpg';
import wintergarten from '../assets/img/wintergarten.jpg';
import festlich from '../assets/img/gastraum-festlich.png';
import { site, openingHours } from '../config/site.ts';
import { getMenu, euro } from '../lib/menu.ts';
import { path, withBase, useT, type Lang } from '../i18n/ui.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const originals = getMenu(lang).find((c) => c.id === 'berliner-originale')!;

const dayCodes = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: site.name,
  url: new URL(path('home', lang), Astro.site).href,
  image: new URL(withBase('/og.jpg'), Astro.site).href,
  telephone: '+49 30 2425247',
  faxNumber: '+49 30 247460130',
  email: site.email,
  servesCuisine: lang === 'de' ? 'Berliner Küche' : 'Berlin cuisine',
  acceptsReservations: true,
  menu: new URL(path('menu', lang), Astro.site).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.zip,
    addressLocality: site.address.city,
    addressCountry: site.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  openingHoursSpecification: openingHours
    .filter((h) => h.opensFrom)
    .map((h) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: dayCodes[h.day], opens: h.opensFrom })),
};
---

<Base
  lang={lang}
  route="home"
  title={t('seo.home.title')}
  description={t('seo.home.desc')}
  overlayHeader
  jsonLd={jsonLd}
>
  <!-- ═════════════ HERO ═════════════ -->
  <section class="grain relative isolate flex min-h-[100svh] items-end overflow-hidden bg-spree-deep text-paper" aria-labelledby="hero-title">
    <div class="absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <div class="absolute inset-x-0 -top-[6%] h-[118%]" data-parallax="0.18">
        <Picture
          src={gericht}
          formats={['avif', 'webp']}
          widths={[640, 960, 1280, 1920]}
          sizes="100vw"
          alt=""
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover object-[30%_50%] opacity-55"
        />
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-spree-deep via-spree-deep/80 to-spree-deep/30 md:bg-gradient-to-r md:from-spree-deep md:via-spree-deep/85 md:to-spree-deep/20"></div>
    </div>

    <div class="container-x grid items-end gap-10 pb-14 pt-32 md:grid-cols-12 md:pb-20 lg:pt-36">
      <div class="md:col-span-7 lg:col-span-7">
        <p class="kicker !text-amber-soft" data-intro>{t('hero.kicker')}</p>
        <h1 id="hero-title" class="mt-5 font-display font-medium uppercase leading-[0.9] tracking-[-0.02em] text-[clamp(3.6rem,15.5vw,9.5rem)]">
          <span class="block" data-intro style="--i:1">{t('hero.l1')}</span>
          <span class="block font-normal normal-case italic text-amber-soft [font-variation-settings:'SOFT'_100,'WONK'_1]" data-intro style="--i:2">
            {t('hero.l2')}
          </span>
          <span class="block" data-intro style="--i:3">{t('hero.l3')}</span>
        </h1>

        <ul class="mt-8 flex flex-col gap-2.5 text-paper/90 sm:flex-row sm:flex-wrap sm:gap-x-8" data-intro style="--i:4">
          <li class="flex items-center gap-2.5">
            <Icon name="pin" class="size-5 text-amber" />
            <span>{site.address.street}, {site.address.zip} {site.address.city}</span>
          </li>
          <li>
            <a href={site.phone.href} class="flex items-center gap-2.5 link-flow">
              <Icon name="phone" class="size-5 text-amber" />
              {site.phone.display}
            </a>
          </li>
        </ul>

        <div class="mt-9 flex flex-wrap items-center gap-3.5" data-intro style="--i:5">
          <CtaButton href={path('reserve', lang)} class="!min-h-14 !px-7 text-lg">{t('nav.reserve')}</CtaButton>
          <a href={path('menu', lang)} class="btn-ghost !min-h-14 text-paper">{t('hero.menu')}</a>
        </div>

        <TerraceNotice lang={lang} class="mt-8 max-w-md" tone="dark" />
      </div>

      <!-- Bogenfenster mit Blick in den Wintergarten -->
      <div class="relative hidden md:col-span-5 md:block" data-intro="scale" style="--i:3">
        <div class="relative ml-auto aspect-[3/4] w-full max-w-[26rem] overflow-hidden rounded-t-full border border-amber-soft/40 p-2.5">
          <div class="relative h-full w-full overflow-hidden rounded-t-full">
            <div class="absolute inset-x-0 -top-[10%] h-[120%]" data-parallax="-0.06">
              <Picture
                src={wintergarten}
                formats={['avif', 'webp']}
                widths={[420, 750]}
                sizes="(min-width: 768px) 26rem, 0px"
                alt={t('hero.imgAlt')}
                loading="eager"
                class="h-full w-full object-cover"
              />
            </div>
          </div>
        </div>
        <span class="absolute -left-6 bottom-10 rotate-[-6deg] rounded-full bg-amber px-4 py-2 font-display text-lg italic text-ink shadow-lg">
          {t('hours.from')}
        </span>
      </div>
    </div>

    <svg class="absolute inset-x-0 bottom-0 h-6 w-full text-paper md:h-10" viewBox="0 0 1440 40" preserveAspectRatio="none" aria-hidden="true">
      <path fill="currentColor" d="M0 40V22c120 0 180-14 300-14s180 14 300 14 180-14 300-14 180 14 300 14 180-14 240-14v32Z"></path>
    </svg>
  </section>

  <!-- ═════════════ WILLKOMMEN ═════════════ -->
  <section class="container-x grid gap-14 py-20 md:py-28 lg:grid-cols-12 lg:gap-12" aria-labelledby="welcome-title">
    <div class="lg:col-span-6">
      <p class="kicker" data-reveal="fade">Spreeblick</p>
      <h2 id="welcome-title" class="mt-4 text-[clamp(2.1rem,4.6vw,3.4rem)] font-medium text-spree" data-reveal style="--i:1">
        {t('welcome.title')}
      </h2>
      <p class="mt-8 font-display text-[1.4rem] leading-snug text-ink md:text-[1.6rem]" data-reveal style="--i:2">
        {t('welcome.p1')}
      </p>
      <div class="mt-6 space-y-4 text-ink-soft" data-reveal style="--i:3">
        <p>{t('welcome.p2')}</p>
        <p>{t('welcome.p3')}</p>
        <p>{t('welcome.p4')}</p>
      </div>
      <p class="mt-8 flex items-start gap-3 border-l-2 border-amber pl-5 font-semibold text-ink" data-reveal style="--i:4">
        {t('welcome.p5')}
      </p>
    </div>

    <div class="relative lg:col-span-6 lg:pl-6">
      <div class="relative ml-auto w-[88%] overflow-hidden rounded-[1.75rem] shadow-[0_30px_60px_-30px_rgb(28_38_34/0.55)]" data-reveal="right">
        <Picture
          src={festlich}
          formats={['avif', 'webp']}
          widths={[560, 1091]}
          sizes="(min-width: 1024px) 34rem, 88vw"
          alt={t('welcome.imgAlt')}
          class="aspect-[4/3] w-full object-cover object-[55%_50%]"
        />
      </div>
      <div class="relative -mt-24 w-[52%] overflow-hidden rounded-t-full border-[6px] border-paper shadow-[0_30px_60px_-30px_rgb(28_38_34/0.6)] sm:-mt-32" data-reveal="left" style="--i:2">
        <Picture
          src={wintergarten}
          formats={['avif', 'webp']}
          widths={[360, 750]}
          sizes="(min-width: 1024px) 20rem, 52vw"
          alt={t('hero.imgAlt')}
          class="aspect-[3/4] w-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- ═════════════ NIKOLAIVIERTEL ═════════════ -->
  <section class="grain relative overflow-hidden bg-spree text-paper" aria-labelledby="quarter-title">
    <div class="container-x grid items-center gap-12 py-20 md:grid-cols-12 md:py-28">
      <figure class="md:col-span-5">
        <Nikolaikirche class="mx-auto w-full max-w-[14rem] text-amber-soft/90 md:max-w-[19rem]" />
        <figcaption class="mt-4 text-center font-display text-sm uppercase tracking-[0.25em] text-paper/60" aria-hidden="true">
          {t('quarter.centuryLabel')}
        </figcaption>
      </figure>
      <div class="md:col-span-7 md:pl-6">
        <p class="kicker !text-amber-soft" data-reveal="fade">{t('quarter.kicker')}</p>
        <h2 id="quarter-title" class="mt-4 text-[clamp(2.1rem,4.6vw,3.4rem)] font-medium" data-reveal style="--i:1">
          {t('quarter.title')}
        </h2>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-paper/85" data-reveal style="--i:2">{t('quarter.text')}</p>
        <p class="mt-10 font-display text-[clamp(4rem,10vw,7rem)] italic leading-none text-amber-soft/25" aria-hidden="true" data-reveal="fade" style="--i:3">
          {t('quarter.century')}
        </p>
      </div>
    </div>
  </section>

  <!-- ═════════════ AUS DER SPEISEKARTE ═════════════ -->
  <section class="container-x py-20 md:py-28" aria-labelledby="teaser-title">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="kicker" data-reveal="fade">{t('teaser.kicker')}</p>
        <h2 id="teaser-title" class="mt-4 text-[clamp(2.1rem,4.6vw,3.4rem)] font-medium text-spree" data-reveal style="--i:1">
          {originals.title}
        </h2>
      </div>
      <a href={`${path('menu', lang)}#${originals.id}`} class="group inline-flex items-center gap-2 font-semibold text-brick" data-reveal="fade" style="--i:2">
        <span class="link-flow">{t('teaser.all')}</span>
        <Icon name="arrow" class="size-4 transition-transform group-hover:translate-x-1" />
      </a>
    </div>
    <ul class="mt-12 grid gap-x-16 border-t border-line md:grid-cols-2">
      {
        originals.entries.map((e, i) => (
          <li class="flex items-baseline gap-4 border-b border-line py-5" data-reveal="item" style={`--i:${i}`}>
            <div class="min-w-0 flex-1">
              <h3 class="font-display text-xl font-medium md:text-[1.35rem]">{e.name}</h3>
              {e.description && <p class="mt-1 text-[0.97rem] leading-snug text-ink-soft">{e.description}</p>}
            </div>
            <span class="shrink-0 font-display text-lg tabular-nums text-brick">{euro(e.prices[0].price, lang)}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ═════════════ RESERVIEREN ═════════════ -->
  <section class="px-4 pb-20 md:pb-28" aria-labelledby="cta-title">
    <div class="grain relative mx-auto max-w-[76rem] overflow-hidden rounded-[2rem] bg-paper-deep px-6 py-14 text-center sm:px-10 md:py-20" data-reveal="scale">
      <svg class="pointer-events-none absolute -right-10 -top-10 size-56 text-amber/20" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="48" fill="none" stroke="currentColor" stroke-width="1"></circle>
        <circle cx="50" cy="50" r="38" fill="none" stroke="currentColor" stroke-width="1"></circle>
      </svg>
      <h2 id="cta-title" class="mx-auto max-w-2xl text-[clamp(2.2rem,5vw,3.75rem)] font-medium text-spree">{t('cta.title')}</h2>
      <p class="mx-auto mt-4 max-w-lg text-lg text-ink-soft">{t('cta.text')}</p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
        <CtaButton href={path('reserve', lang)} class="!min-h-14 !px-8 text-lg">{t('nav.reserve')}</CtaButton>
        <a href={site.phone.href} class="btn-ghost !min-h-14 text-spree">
          <Icon name="phone" class="size-5" />
          {site.phone.display}
        </a>
      </div>
      <p class="mx-auto mt-8 max-w-md text-sm text-ink-soft">{t('terrace')}</p>
    </div>
  </section>
</Base>
