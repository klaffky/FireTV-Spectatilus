---
import Base from '../layouts/Base.astro';
import { site } from '../config/site.ts';
import { useT, type Lang } from '../i18n/ui.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<Base lang={lang} route="imprint" title={t('seo.imprint.title')} description={t('seo.imprint.desc')}>
  <div class="container-x pb-20 pt-12 md:pt-20">
    <h1 class="text-[clamp(2.6rem,7vw,4.5rem)] font-medium text-spree" data-intro>{t('imprint.title')}</h1>
    <div class="prose-legal mt-10">
      <h2 class="!mt-0">{t('imprint.according')}</h2>
      <p>
        <strong class="text-ink">{site.legal.company}</strong><br />
        {site.address.street}<br />
        {`${site.address.zip} ${site.address.city}`}
      </p>
      <p>
        {t('imprint.register')}: {site.legal.register}<br />
        {t('imprint.court')}: {site.legal.court}
      </p>
      <h3>{t('imprint.rep')}</h3>
      <p>{site.legal.representative}</p>
      <h3>{t('imprint.contact')}</h3>
      <p>
        {t('imprint.phone')}: <a href={site.phone.href}>{site.phone.display}</a><br />
        {t('contact.email')}: <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <h3>{t('imprint.vat')}</h3>
      <p>
        {t('imprint.vatText')}<br />
        {site.legal.vatId}
      </p>
      <h3>{t('imprint.dispute')}</h3>
      <p>{t('imprint.disputeText')}</p>
    </div>
  </div>
</Base>
